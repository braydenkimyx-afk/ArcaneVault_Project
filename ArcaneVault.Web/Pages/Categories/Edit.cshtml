@page "{code}"
@model ArcaneVault.Web.Pages.Categories.EditModel
@{ ViewData["Title"] = "Edit Category"; }

<div class="row justify-content-center fade-in"><div class="col-md-6">
    <div class="card shadow">
        <div class="card-header py-3"><h4 class="mb-0" style="color: var(--av-text);"><i class="bi bi-pencil me-2"></i>Edit Category</h4></div>
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Code" />
                <div class="mb-3">
                    <label class="form-label">Category Code</label>
                    <input class="form-control" value="@Model.Code" disabled />
                </div>
                <div class="mb-4">
                    <label asp-for="Input.CategoryName" class="form-label"></label>
                    <input asp-for="Input.CategoryName" class="form-control" />
                    <span asp-validation-for="Input.CategoryName" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-2"></i>Update</button>
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div></div>
