@page "{code?}"
@model ArcaneVault.Web.Pages.Categories.DeleteModel
@{ ViewData["Title"] = "Delete Category"; }

<div class="row justify-content-center fade-in"><div class="col-md-6">
    @if (Model.Category == null)
    {
        <div class="alert alert-warning">Category not found.</div>
    }
    else
    {
        <div class="card shadow border-danger">
            <div class="card-header py-3"><h4 class="mb-0 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete</h4></div>
            <div class="card-body p-4">
                <p>Are you sure you want to delete this category? This cannot be undone if no items reference it.</p>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Code</dt><dd class="col-sm-8"><span class="badge badge-category">@Model.Category.CategoryCode</span></dd>
                    <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.Category.CategoryName</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <form method="post">
                    <input type="hidden" name="code" value="@Model.Category.CategoryCode" />
                    <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash me-1"></i>Delete</button>
                </form>
                <a asp-page="Index" class="btn btn-secondary btn-sm">Cancel</a>
            </div>
        </div>
    }
</div></div>
