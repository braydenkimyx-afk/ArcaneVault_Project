<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArcaneVault</title>
    <meta name="description" content="ArcaneVault — Collection Management System" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/item-art.css" />
    <style>
        .nav-link-logout:hover {
            color: var(--av-danger) !important;
        }
        .footer-bottom {
            border-top: 1px solid var(--av-border);
            padding-top: 1.5rem;
            margin-top: 2rem;
            text-align: center;
        }
        .footer-bottom-text {
            color: var(--av-text-subtle);
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-gem me-2"></i>ArcaneVault
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" href="/">
                            <i class="bi bi-house-door me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Browse") == true ? "active" : "")"
                           asp-page="/Browse/Index">
                            <i class="bi bi-search me-1"></i>Browse
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/CollectionItems") == true ? "active" : "")"
                               asp-page="/CollectionItems/Index">
                                <i class="bi bi-collection me-1"></i>@(User.IsInRole("Staff") ? "All Collections" : "My Collection")
                            </a>
                        </li>
                        @if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Categories") == true ? "active" : "")"
                                   asp-page="/Categories/Index">
                                    <i class="bi bi-tags me-1"></i>Category Management
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Dashboard") == true ? "active" : "")"
                               asp-page="/Dashboard/Index">
                                <i class="bi bi-bar-chart me-1"></i>Dashboard
                            </a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link" style="color: var(--av-text);">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                @if (User.IsInRole("Staff"))
                                {
                                    <span class="badge ms-1" style="background-color: var(--av-accent-soft); color: var(--av-accent); border: 1px solid var(--av-accent-border);">Staff</span>
                                }
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-logout" asp-page="/Account/Logout">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Account/Login" ? "active" : "")"
                               asp-page="/Account/Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Account/Register" ? "active" : "")"
                               asp-page="/Account/Register">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-4" style="z-index: 1100;" id="toastContainer"></div>

    <!-- Main Content -->
    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- 4-Column Footer (STEP 3) -->
    <footer class="mt-auto py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 col-12">
                    <h5 class="footer-heading">Manage</h5>
                    <ul class="list-unstyled mb-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li><a href="/CollectionItems" class="footer-link">@(User.IsInRole("Staff") ? "All Collections" : "My Collection")</a></li>
                        <li><a href="/CollectionItems/Create" class="footer-link">Add Item</a></li>
                        <li><a href="/Dashboard" class="footer-link">Dashboard</a></li>
                        <li><a href="/Dashboard" class="footer-link">Low Stock Alerts</a></li>
                    }
                    else
                    {
                        <li><a href="/Account/Login" class="footer-link">My Collection</a></li>
                        <li><a href="/Account/Login" class="footer-link">Add Item</a></li>
                        <li><a href="/Account/Login" class="footer-link">Dashboard</a></li>
                        <li><a href="/Account/Login" class="footer-link">Low Stock Alerts</a></li>
                    }
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6 col-12">
                    <h5 class="footer-heading">Account</h5>
                    <ul class="list-unstyled mb-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li><a href="/Account/Logout" class="footer-link">Logout</a></li>
                        <li><a href="/CollectionItems" class="footer-link">@(User.IsInRole("Staff") ? "All Collections" : "My Collection")</a></li>
                    }
                    else
                    {
                        <li><a href="/Account/Login" class="footer-link">Login</a></li>
                        <li><a href="/Account/Register" class="footer-link">Register</a></li>
                        <li><a href="/Account/ForgotPassword" class="footer-link">Forgot Password</a></li>
                    }
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6 col-12">
                    <h5 class="footer-heading">About ArcaneVault</h5>
                    <p style="color: var(--av-text-muted); font-size: 0.875rem; margin-bottom: 0.5rem;">
                        ArcaneVault is a premium collection-management prototype crafted for dedicated collectors and hobby shops.
                    </p>
                    <p style="color: var(--av-text-muted); font-size: 0.8rem; margin-top: 1rem;"><i class="bi bi-shop me-1"></i>Marketplace &mdash; coming soon</p>
                </div>
            </div>
            
            <div class="footer-bottom">
                <small class="footer-bottom-text">&copy; 2026 ArcaneVault &mdash; All Rights Reserved.</small>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.21.0/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function showToast(message, type = 'success') {
            const icons = { success: 'check-circle-fill', danger: 'exclamation-triangle-fill', warning: 'exclamation-triangle-fill', info: 'info-circle-fill' };
            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-bg-${type} border-0 show mb-2`;
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-${icons[type] || 'info-circle-fill'} me-2"></i>${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>`;
            document.getElementById('toastContainer').appendChild(toast);
            setTimeout(() => toast.remove(), 5000);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const successMsg = '@(TempData["Success"]?.ToString()?.Replace("'", "\\'") ?? "")';
            const errorMsg = '@(TempData["Error"]?.ToString()?.Replace("'", "\\'") ?? "")';
            if (successMsg) showToast(successMsg, 'success');
            if (errorMsg) showToast(errorMsg, 'danger');
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
