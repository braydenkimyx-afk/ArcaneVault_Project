@page
@model ArcaneVault.Web.Pages.Browse.DetailsModel
@{
    ViewData["Title"] = Model.Item.ItemName;
    var primaryCategory = Model.Item.Categories.FirstOrDefault()?.CategoryCode ?? "ART";
}

<div class="container py-4 fade-in">
    <div class="mb-4 d-flex align-items-center justify-content-between">
        <a href="/Browse" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back to Browse</a>
        
        @if (User.Identity?.IsAuthenticated == true && User.Identity.Name == Model.Item.UserName)
        {
            <a asp-page="/CollectionItems/Edit" asp-route-id="@Model.Item.ItemId" class="btn btn-primary"><i class="bi bi-pencil me-2"></i>Manage this item</a>
        }
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
        <div class="row g-0">
            <!-- Left Layout: Media -->
            <div class="col-md-5 bg-light p-4 d-flex align-items-center justify-content-center" style="min-height: 400px; border-right: 1px solid var(--av-border);">
                <div style="width: 100%; max-width: 320px; box-shadow: 0 12px 32px rgba(0,0,0,0.15); border-radius: 12px; overflow: hidden;">
                    <partial name="_ItemTile" model="@((Model.Item.ItemId, primaryCategory, false, Model.Item.HasImage, Model.Item.ItemName))" />
                </div>
            </div>

            <!-- Right Layout: Details -->
            <div class="col-md-7 p-5 d-flex flex-column">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var cat in Model.Item.Categories)
                    {
                        <span class="badge border bg-light text-dark fs-6 fw-normal px-3 py-2">@cat.CategoryName</span>
                    }
                </div>

                <h1 class="display-5 fw-bold mb-3" style="color: var(--av-text);">@Model.Item.ItemName</h1>
                
                <div class="d-flex align-items-center mb-4" style="color: var(--av-text-muted); font-size: 1.1rem;">
                    <i class="bi bi-person-circle fs-4 me-2"></i>
                    <span>Owned by <strong>@Model.Item.UserName</strong></span>
                </div>

                <hr class="w-100 my-4" style="opacity: 0.1;" />

                <div class="row g-4 mb-auto">
                    <div class="col-6">
                        <div class="text-uppercase fw-bold mb-1" style="font-size: 0.85rem; letter-spacing: 1px; color: var(--av-text-subtle);">Current Collection Qty</div>
                        <div class="fs-2 fw-semibold" style="color: var(--av-text);">@Model.Item.CurrentQuantity</div>
                        @if (Model.Item.CurrentQuantity <= Model.Item.StartingQuantity * 0.2)
                        {
                            <span class="badge mt-2" style="background-color: var(--av-danger-soft); color: var(--av-danger); border: 1px solid var(--av-danger); font-size: 0.85rem;">Low Stock</span>
                        }
                    </div>
                    <div class="col-6">
                        <div class="text-uppercase fw-bold mb-1" style="font-size: 0.85rem; letter-spacing: 1px; color: var(--av-text-subtle);">Starting Catalog Qty</div>
                        <div class="fs-2 fw-semibold" style="color: var(--av-text-muted);">@Model.Item.StartingQuantity</div>
                    </div>
                    <div class="col-6">
                        <div class="text-uppercase fw-bold mb-1" style="font-size: 0.85rem; letter-spacing: 1px; color: var(--av-text-subtle);">Listed Price</div>
                        @if (Model.Item.Price.HasValue)
                        {
                            <div class="fs-2 fw-bold" style="color: var(--av-accent);">@Model.Item.Price.Value.ToString("C")</div>
                        }
                        else
                        {
                            <div class="fs-4 fw-semibold text-muted">—</div>
                            <div class="small text-muted mt-1">No price listed</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
