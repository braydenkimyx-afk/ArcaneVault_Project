@page
@model ArcaneVault.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Reset Password"; }

<div class="row justify-content-center fade-in">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header text-center py-3"><h4 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Set New Password</h4></div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Input.Token" />
                    <input type="hidden" asp-for="Input.UserName" />
                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label"></label>
                        <input asp-for="Input.NewPassword" class="form-control" type="password" id="passwordInput" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                        <div class="mt-2"><div class="bg-secondary rounded" style="height:6px;"><div class="password-strength-bar" id="strengthBar"></div></div><small id="strengthText" class="text-muted"></small></div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-lg me-2"></i>Reset Password</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('passwordInput')?.addEventListener('input', function () {
            const p = this.value; let s = 0;
            if (p.length >= 8) s++; if (/[A-Z]/.test(p)) s++; if (/[0-9]/.test(p)) s++; if (/[^A-Za-z0-9]/.test(p)) s++;
            const bar = document.getElementById('strengthBar'), text = document.getElementById('strengthText');
            const levels = ['','strength-weak','strength-fair','strength-good','strength-strong'];
            const labels = ['','Weak','Fair','Good','Strong'];
            const colors = ['','text-danger','text-warning','text-info','text-success'];
            bar.className = 'password-strength-bar ' + (levels[s]||'');
            text.className = 'small ' + (colors[s]||'text-muted'); text.textContent = labels[s]||'';
        });
    </script>
}
