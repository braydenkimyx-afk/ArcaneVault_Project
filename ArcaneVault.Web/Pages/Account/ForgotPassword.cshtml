@page
@model ArcaneVault.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Forgot Password"; }

<div class="row justify-content-center fade-in">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header text-center py-3"><h4 class="mb-0"><i class="bi bi-key me-2"></i>Reset Password</h4></div>
            <div class="card-body p-4">
                @if (Model.ResetToken != null)
                {
                    <div class="alert alert-success">
                        <strong>Token generated!</strong><br/>
                        <small>In production this would be emailed. For testing, use this token:</small>
                        <div class="mt-2 p-2 bg-dark rounded text-break"><code>@Model.ResetToken</code></div>
                        <a asp-page="/Account/ResetPassword" asp-route-token="@Model.ResetToken" asp-route-userName="@Model.ResetUserName" class="btn btn-primary btn-sm mt-2">Reset Password Now</a>
                    </div>
                }
                else
                {
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input asp-for="Input.Email" class="form-control" placeholder="Registered email" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-envelope me-2"></i>Request Reset Token</button>
                    </form>
                }
                <hr class="my-3" style="border-color: var(--av-border);" />
                <p class="text-center mb-0"><a asp-page="/Account/Login">Back to Login</a></p>
            </div>
        </div>
    </div>
</div>
